# ================================
# Admin Residencial - Configuración Local
# ================================
# Modifique los valores según su conjunto residencial

# ========== INFORMACIÓN DEL CONJUNTO ==========
CONJUNTO_NOMBRE=Mi Conjunto Residencial

# ========== CREDENCIALES SUPERADMIN ==========
SUPERADMIN_CEDULA=123456789
SUPERADMIN_PASSWORD=CambiarEstaClaveSegura2024

# ========== SEGURIDAD ==========
# IMPORTANTE: Genere una clave secreta única
JWT_SECRET=cambiar_por_clave_secreta_muy_larga_y_segura_minimo_64_caracteres

# ========== CONFIGURACIÓN DE CÁMARA ==========
CAMERA_RTSP_URL=rtsp://admin:admin123@192.168.1.100:554/stream1
CAMERA_CONJUNTO_ID=

# ========== NO MODIFICAR ==========
MONGO_URI=mongodb://mongodb:27017/adminResidencial
NODE_ENV=production
PORT=5000

# ========== TELEMETRÍA (Reporte a Azure) ==========
# ID único de esta instalación (generar uno nuevo)
# Usar: https://www.uuidgenerator.net/
INSTALACION_ID=

# Nombre de la instalación (se mostrará en panel de control)
NOMBRE_INSTALACION=

# URL del servidor central (no modificar)
AZURE_URL=https://safe-entry-fff6afd0gje3drcq.chilecentral-01.azurewebsites.net

# Intervalo de heartbeat en milisegundos (300000 = 5 min)
HEARTBEAT_INTERVALO=300000
