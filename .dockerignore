# Dependencies
node_modules
npm-debug.log*

# Environment files (se pasan como variables)
.env
.env.*

# Git
.git
.gitignore

# Logs
logs/
*.log

# IDE
.vscode
.idea

# Python (reconocimiento de placas se corre aparte)
.venv
venv
__pycache__
*.py[cod]
*.pt

# OS
.DS_Store
Thumbs.db

# Docs
*.md
!README.md

# Tests
coverage
.nyc_output

# Temporales
tmp
temp
*.tmp
