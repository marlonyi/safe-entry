# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================

# Puerto del servidor (por defecto 5000)
PORT=5000

# Ambiente: development o production
NODE_ENV=development

# ==========================================
# BASE DE DATOS MONGODB
# ==========================================

# URI de conexión a MongoDB
# Para local: mongodb://localhost:27017/adminResidencial
# Para Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/adminResidencial
MONGO_URI=mongodb://localhost:27017/adminResidencial

# ==========================================
# SEGURIDAD JWT
# ==========================================

# ⚠️ IMPORTANTE: Clave secreta para firmar tokens JWT
# EN PRODUCCIÓN: Usar una clave larga (mínimo 32 caracteres), aleatoria y única
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NUNCA usar el valor por defecto en producción
JWT_SECRET=tu_clave_secreta_muy_segura_aqui_minimo_32_caracteres

# ==========================================
# URLS DEL FRONTEND (para CORS)
# ==========================================

# URL local para desarrollo
FRONTEND_URL_LOCAL=http://localhost:5000

# URL de producción (Azure, Vercel, etc.)
FRONTEND_URL_PROD=https://tu-app.azurewebsites.net

# ==========================================
# CREDENCIALES ADMIN INICIAL
# ==========================================

# Solo se usan si no existe un admin en la BD
ADMIN_CEDULA=123456789
ADMIN_PASSWORD=admin123

# ==========================================
# LOGGING
# ==========================================

# Nivel de log: error, warn, info, debug
LOG_LEVEL=info
