# ================================
# Admin Residencial - Configuración Local
# ================================
# Copie este archivo como .env.local y modifique los valores

# ========== INFORMACIÓN DEL CONJUNTO ==========
CONJUNTO_NOMBRE=Mi Conjunto Residencial

# ========== CREDENCIALES SUPERADMIN ==========
# Estas son las credenciales del administrador principal
SUPERADMIN_CEDULA=123456789
SUPERADMIN_PASSWORD=CambiarEstaClaveSegura2024

# ========== SEGURIDAD ==========
# IMPORTANTE: Genere una clave secreta única para producción
# Puede usar: https://randomkeygen.com/ (CodeIgniter Encryption Keys)
JWT_SECRET=cambiar_por_clave_secreta_muy_larga_y_segura_minimo_64_caracteres

# ========== CONFIGURACIÓN DE CÁMARA (Reconocimiento de Placas) ==========
# Dirección RTSP de la cámara IP
# Formato típico: rtsp://usuario:password@ip:puerto/stream
CAMERA_RTSP_URL=rtsp://admin:admin123@192.168.1.100:554/stream1

# Conjunto ID para registrar los accesos (se configura después del primer inicio)
CAMERA_CONJUNTO_ID=

# ========== BASE DE DATOS ==========
# No modificar si usa Docker
MONGO_URI=mongodb://mongodb:27017/adminResidencial

# ========== SERVIDOR ==========
NODE_ENV=production
PORT=5000
