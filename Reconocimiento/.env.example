# Configuración del servicio de Reconocimiento de Placas (LPR)
# Copia este archivo a .env y completa los valores reales (NUNCA subir .env con secretos).

# Cadena de conexión a MongoDB (local o Atlas)
# Local:  mongodb://localhost:27017/adminResidencial
# Atlas:  mongodb+srv://usuario:password@cluster.mongodb.net/adminResidencial
MONGO_URI=mongodb://localhost:27017/adminResidencial
