# Configuración del QR Scanner
# Copiar a .env y modificar según el ambiente

# URL del servidor Node.js
API_BASE_URL=http://localhost:5000

# ID del conjunto (dejar vacío para selector de conjuntos)
# CONJUNTO_ID=

# Índice de la cámara (0 = primera cámara)
CAMERA_INDEX=0

# Tiempo de espera entre lecturas del mismo QR (segundos)
COOLDOWN_SECONDS=10

# Modo debug (muestra más información en consola)
DEBUG=false
